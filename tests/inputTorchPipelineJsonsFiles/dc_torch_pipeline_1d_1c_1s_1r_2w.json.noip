{
    "nerlnetSettings": {
        "frequency": "5",
        "batchSize": "50"
    },
    "mainServer": {
        "port": "8081",
        "args": ""
    },
    "apiServer": {
        "port": "8082",
        "args": ""
    },
    "devices": [
        {
            "name": "pc1",
            "ipv4": "x.x.x.x",
            "entities": "client_1,r1,s1,apiServer,mainServer,super_0"
        }
    ],
    "routers": [
        {"name": "r1", "port": "28086", "policy": "0"}
    ],
    "sources": [
        {
            "name": "s1",
            "port": "28085",
            "frequency": "5",
            "policy": "0",
            "epochs": "1",
            "type": "0"
        }
    ],
    "superNodes": [
        {
            "name": "super_0",
            "port": "28090",
            "managedClients": ["client_1"],
            "heartbeatMs": 1000,
            "maxInflightMicrobatches": 16
        }
    ],
    "clients": [
        {
            "name": "client_1",
            "port": "28083",
            "workers": "w1,w2",
            "superNode": "super_0"
        }
    ],
    "workers": [
        {
            "name": "w1",
            "model_sha": "pipeline_test_model_placeholder",
            "parallel": {
                "pipelineStage": 0,
                "pipelineWorldSize": 2
            }
        },
        {
            "name": "w2",
            "model_sha": "pipeline_test_model_placeholder",
            "parallel": {
                "pipelineStage": 1,
                "pipelineWorldSize": 2
            }
        }
    ],
    "model_sha": {
        "pipeline_test_model_placeholder": {
            "infraType": "torch",
            "_doc_infraType": " opennn:0 | wolfengine:1 | torch:2 |",
            "distributedSystemType": "0",
            "_doc_distributedSystemType": " none:0 | fedClientAvg:1 | fedServerAvg:2 |",
            "distributedSystemArgs": "",
            "_doc_distributedSystemArgs": "String",
            "distributedSystemToken": "none",
            "_doc_distributedSystemToken": "Token that associates distributed group of workers and parameter-server",
            "pt_path": "tests/inputTorchJsonsFiles/models/placeholder_pipeline.pt",
            "pt_format": "torchscript",
            "pt_checksum": "placeholder",
            "pt_description": "Pipeline TorchScript placeholder for pipeline parallelism tests",
            "train_params": {
                "lr": "0.001",
                "epochs": "1",
                "optimizer": "adam",
                "loss": "mse",
                "batch_size": "50",
                "input_tensor_shape": "[50, 5]",
                "labels_offset": "default",
                "labels_shape": "[50, 3]",
                "w_init_rand": "True"
            }
        }
    }
}
